generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  email          String?   @unique
  name           String?
  nickname           String?   @unique
  nickname_defined   Boolean   @default(false)
  lastNicknameChange DateTime? // Mantido meta para admins
  avatar             String?
  twitchId       String?   @unique
  googleId       String?   @unique
  roles          Json      @default("[\"USER\"]") // 'OWNER', 'ADMIN_DOWNLOADS', 'ADMIN_GERACAO', 'USER'
  lastActiveAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  topics         Topic[]
  comments       Comment[]
  squads         Squad[]
  auditLogs      AuditLog[] @relation("UserAuditLogs")
  likes          TopicLike[]
}

model Topic {
  id          String    @id @default(uuid())
  title       String
  content     String    @db.Text
  category    String
  status      String    @default("PENDING") // 'APPROVED', 'PENDING', 'REJECTED'
  moderationReason String? @db.Text
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments    Comment[]
  likes       TopicLike[]
}

model Comment {
  id          String    @id @default(uuid())
  content     String    @db.Text
  topicId     String
  topic       Topic     @relation(fields: [topicId], references: [id])
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Squad {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  defensorId  Int?
  meioId      Int?
  ataqueId    Int?
  bancoId     Int?
  bagreId     Int?
  roundScore  Int       @default(0)
  totalScore  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// 🛡️ Tabela de Auditoria de Segurança
model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("UserAuditLogs", fields: [userId], references: [id])
  targetId    String?  // ID do recurso afetado (outro usuário, post, etc)
  action      String   // Ex: 'SET_NICKNAME', 'BAN_USER', 'APPROVE_DOWNLOAD'
  details     Json?    // Dados adicionais (JSON)
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model TopicLike {
  id        String   @id @default(uuid())
  topicId   String
  userId    String
  createdAt DateTime @default(now())

  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
}
