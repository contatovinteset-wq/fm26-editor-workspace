generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  email          String?   @unique
  name           String?
  password       String?
  nickname       String?   @unique
  nickname_defined   Boolean   @default(false)
  lastNicknameChange DateTime? // Mantido meta para admins
  avatar             String?
  twitchId       String?   @unique
  googleId       String?   @unique
  roles          Json      @default("[\"USER\"]") // 'OWNER', 'ADMIN_DOWNLOADS', 'ADMIN_GERACAO', 'USER'
  lastActiveAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  topics         Topic[]
  comments       Comment[]
  squads         Squad[]
  auditLogs      AuditLog[] @relation("UserAuditLogs")
  likes          TopicLike[]
  craqueVotes    CraqueVote[]

  forumTopics    ForumTopic[]
  forumPosts     ForumPost[]

  creators       Creator[] @relation("UserCreators")
}

model Topic {
  id          String    @id @default(uuid())
  title       String
  content     String    @db.Text
  category    String
  status      String    @default("PENDING") // 'APPROVED', 'PENDING', 'REJECTED'
  moderationReason String? @db.Text
  views       Int       @default(0)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments    Comment[]
  likes       TopicLike[]
}

model Comment {
  id          String    @id @default(uuid())
  content     String    @db.Text
  topicId     String
  topic       Topic     @relation(fields: [topicId], references: [id])
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Squad {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  creatorId   String
  creator     Creator   @relation(fields: [creatorId], references: [id])

  defensorId  String?
  defensor    Player?   @relation("SquadDefensor", fields: [defensorId], references: [id])
  
  meioId      String?
  meio        Player?   @relation("SquadMeio", fields: [meioId], references: [id])
  
  ataqueId    String?
  ataque      Player?   @relation("SquadAtaque", fields: [ataqueId], references: [id])
  
  bancoId     String?
  banco       Player?   @relation("SquadBanco", fields: [bancoId], references: [id])
  
  bagreId     String?
  bagre       Player?   @relation("SquadBagre", fields: [bagreId], references: [id])

  capitaoId   String?
  capitao     Player?   @relation("SquadCapitao", fields: [capitaoId], references: [id])
  
  roundScore  Float     @default(0.0)
  totalScore  Float     @default(0.0)
  overlayNotified Boolean @default(false) // já apareceu no overlay nesta rodada (reseta ao abrir rodada)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, creatorId])
}

// 👑 Tabelas do Rei da Mesa (Cartola)

// 🎥 Multi-tenant: cada criador de conteúdo tem o seu próprio Rei da Mesa.
model Creator {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation("UserCreators", fields: [ownerId], references: [id])
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  branding  Json?
  lineupPrint   String?   @db.LongText // print da escalação do criador (base64 dataURL)
  lineupPrintAt DateTime?              // quando o print foi atualizado
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players      Player[]
  rounds       Round[]
  squads       Squad[]
  playerScores PlayerScore[]
  craqueVotes  CraqueVote[]
  reiDaMesaState ReiDaMesaState?
  overlayEvents  OverlayEvent[]
  seasons        Season[]
  roundEntries   RoundEntry[]
}

model Player {
  id           String        @id @default(uuid())
  uidName      String
  name         String
  realPosition String?
  cartolaRole  String?       @default("") // Ex: "DEF", "MEI", "ATA", ""
  age          Int?
  height       String?
  price        Float         @default(5.0)
  eligible     Boolean       @default(true)
  rawStats     Json?
  uniqueId     String?

  creatorId    String
  creator      Creator  @relation(fields: [creatorId], references: [id])

  squadsDef    Squad[]  @relation("SquadDefensor")
  squadsMei    Squad[]  @relation("SquadMeio")
  squadsAta    Squad[]  @relation("SquadAtaque")
  squadsBanco  Squad[]  @relation("SquadBanco")
  squadsBagre  Squad[]  @relation("SquadBagre")
  squadsCapitao Squad[] @relation("SquadCapitao")

  scores       PlayerScore[]
  bagreOfRound Round[]  @relation("RoundBagre")
  craqueVotes  CraqueVote[]

  @@unique([creatorId, uidName])
}

model Round {
  id          String   @id @default(uuid())
  number      Int
  isOpen      Boolean  @default(false)
  isFinished  Boolean  @default(false)
  
  bagreId     String?  // Id do pior jogador da rodada computado no admin
  bagre       Player?  @relation("RoundBagre", fields: [bagreId], references: [id])

  // Resultado da rodada (Fase 6 — Sala de Troféus / recordes históricos)
  championId   String?  // userId do campeão da rodada (sem relação formal)
  championName String?  // snapshot do nick do campeão na época
  topScore     Float?   // maior pontuação feita nesta rodada

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id])

  // Gamificação (G1): a qual temporada esta rodada pertence (coluna simples).
  seasonId    String?

  scores      PlayerScore[]
  craqueVotes CraqueVote[]
  entries     RoundEntry[]

  @@unique([creatorId, number])
}

// 🎮 Gamificação (G1) — Temporadas: agrupam rodadas e coroam um campeão ao encerrar.
model Season {
  id            String    @id @default(uuid())
  number        Int       // sequencial por criador
  name          String?   // rótulo opcional (ex: "Temporada de Verão")
  isActive      Boolean   @default(true) // a temporada em curso do criador
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  championId    String?   // userId do campeão da temporada (snapshot, sem relação)
  championName  String?
  championScore Float?

  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id])

  @@unique([creatorId, number])
  @@index([creatorId, isActive])
}

// 🎮 Gamificação (G1) — RoundEntry: histórico da pontuação de cada viewer em cada
// rodada (a fundação que faltava). Habilita classificação por temporada, conquistas
// e, no futuro, duelos/valorização.
model RoundEntry {
  id        String   @id @default(uuid())
  roundId   String
  round     Round    @relation(fields: [roundId], references: [id])
  userId    String   // sem relação formal (espelha Round.championId)
  seasonId  String?  // coluna simples
  score     Float    @default(0.0)
  rank      Int?     // posição do viewer naquela rodada (1 = campeão)
  createdAt DateTime @default(now())

  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id])

  @@unique([roundId, userId])
  @@index([creatorId, seasonId])
  @@index([userId])
}

model PlayerScore {
  id          String   @id @default(uuid())
  playerId    String
  roundId     String
  player      Player   @relation(fields: [playerId], references: [id])
  round       Round    @relation(fields: [roundId], references: [id])
  
  rating      Float    @default(0.0) // Nota do match stats FM
  points      Float    @default(0.0) // Pontuação algébrica final de Cartola
  details     Json?    // Salva por quais estatísticas o cara pontuou (Gols: 1, Cartoes: 0)

  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id])

  @@unique([playerId, roundId])
}

// ⚙️ Estado do Rei da Mesa (antes ficava em memória no processo).
// Fase 3b: 1 linha por criador (creatorId é a PK). Cada criador tem o seu
// mercado aberto/fechado, persistido entre deploys/restarts.
model ReiDaMesaState {
  creatorId    String   @id
  creator      Creator  @relation(fields: [creatorId], references: [id])
  isMarketOpen Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

// 📺 Eventos do overlay do OBS (antes era fila em memória).
// Fase 3b: por criador. O poll do front lê os eventos do creator com id > since.
model OverlayEvent {
  id        Int      @id @default(autoincrement())
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id])

  @@index([creatorId, createdAt])
}

// 🛡️ Tabela de Auditoria de Segurança
model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("UserAuditLogs", fields: [userId], references: [id])
  targetId    String?  // ID do recurso afetado (outro usuário, post, etc)
  action      String   // Ex: 'SET_NICKNAME', 'BAN_USER', 'APPROVE_DOWNLOAD'
  details     Json?    // Dados adicionais (JSON)
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model TopicLike {
  id        String   @id @default(uuid())
  topicId   String
  userId    String
  createdAt DateTime @default(now())

  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
}

model CraqueVote {
  id        String   @id @default(uuid())
  userId    String
  roundId   String
  playerId  String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  round     Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id])

  @@unique([userId, roundId])
}

// 💬 Tabelas do Fórum Principal
model ForumCategory {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  icon        String?

  topics      ForumTopic[]
}

model ForumTopic {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  isPinned    Boolean  @default(false)
  isClosed    Boolean  @default(false)
  status      String   @default("PENDING")
  moderationReason String? @db.Text
  views       Int      @default(0)

  categoryId  String
  category    ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  posts       ForumPost[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ForumPost {
  id          String   @id @default(uuid())
  content     String   @db.Text
  status      String   @default("PENDING")
  moderationReason String? @db.Text

  topicId     String
  topic       ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
