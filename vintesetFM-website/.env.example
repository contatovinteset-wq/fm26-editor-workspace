# Variáveis de Integração do Site vintesetFM

# 1. TWITCH API
# Você precisa de um Client ID e um App Access Token (Token de Aplicativo).
# O App Access Token expira de tempos em tempos (normalmente 60 dias) e precisa ser renovado via requisição POST pra Twitch.
VITE_TWITCH_CLIENT_ID=seu_client_id_aqui
VITE_TWITCH_APP_ACCESS_TOKEN=seu_access_token_aqui

# 2. YOUTUBE DATA API V3
# Você precisa de uma API Key simples do Google Cloud Console.
VITE_YOUTUBE_API_KEY=sua_api_key_do_youtube_aqui
