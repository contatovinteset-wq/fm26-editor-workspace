<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>FM26PlayerProfileDiag</AssemblyName>
    <Product>FM26 Player Profile Diagnostic</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.738" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" IncludeAssets="build" />
    <PackageReference Include="Il2CppInterop.Runtime" Version="1.4.5" IncludeAssets="compile" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.0.52f1" IncludeAssets="compile" />
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)bin\" />
  </Target>

</Project>
