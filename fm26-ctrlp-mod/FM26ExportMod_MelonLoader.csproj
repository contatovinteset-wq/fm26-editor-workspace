<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>FM26ExportMod</AssemblyName>
    <Product>FM26 Ctrl+P Export Mod</Product>
    <Version>1.0.0</Version>
    <OutputType>Library</OutputType>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- MelonLoader dependencies -->
    <PackageReference Include="MelonLoader" Version="0.6.1" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.20" />
  </ItemGroup>

  <!-- Output para a pasta Mods -->
  <PropertyGroup>
    <OutDir>bin\</OutDir>
  </PropertyGroup>

</Project>
