<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Tenta localizar o FM26 automaticamente -->
  <PropertyGroup>
    <FM26Path Condition="Exists('E:\Steam\steamapps\common\Football Manager 26')">E:\Steam\steamapps\common\Football Manager 26</FM26Path>
    <FM26Path Condition="Exists('C:\Program Files (x86)\Steam\steamapps\common\Football Manager 26')">C:\Program Files (x86)\Steam\steamapps\common\Football Manager 26</FM26Path>
    <FM26Path Condition="Exists('$(HOME)\.steam\steam\steamapps\common\Football Manager 26')">$(HOME)\.steam\steam\steamapps\common\Football Manager 26</FM26Path>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(FM26Path)\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(FM26Path)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(FM26Path)\BepInEx\interop\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(FM26Path)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(FM26Path)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(FM26Path)\BepInEx\interop\UnityEngine.UIElementsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputSystemModule">
      <HintPath>$(FM26Path)\BepInEx\interop\UnityEngine.InputSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
