<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>FM26SceneDump</AssemblyName>
    <Product>FM26 Scene Dump</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);IL2CPP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.738" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" IncludeAssets="build" />
  </ItemGroup>

  <!-- Referências do Unity - o MSBuild do BepInEx resolve automaticamente -->
  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
